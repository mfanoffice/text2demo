{
  "name": "dsh-deck-workbench",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "description": "把一段口播文案变成可翻页的演示动画，并生成视频标题、标签与三比例封面。本机自用，不上架。",
  "license": "MIT",
  "author": "fanyumin",
  "main": "./dsh/plugin.js",
  "exports": {
    ".": "./dsh/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/build-assets.mjs && node scripts/check-package.mjs"
  }
}
